<script>
(() => {
  const form = document.getElementById('testForm');
  const target = document.getElementById('target');
  const count = document.getElementById('count');
  const delay = document.getElementById('delay');
  const start = document.getElementById('start');
  const stop = document.getElementById('stop');
  const clear = document.getElementById('clear');
  const results = document.getElementById('results');
  const status = document.getElementById('status');
  const totalEl = document.getElementById('total');
  const successEl = document.getElementById('success');
  const limitedEl = document.getElementById('limited');
  let stopped = false;
  let running = false;
  let totals = { total: 0, success: 0, limited: 0 };

  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
  function updateStats() {
    totalEl.textContent = totals.total;
    successEl.textContent = totals.success;
    limitedEl.textContent = totals.limited;
  }
  function addResult(text, code, cls) {
    const row = document.createElement('div');
    row.className = 'result';
    const label = document.createElement('span');
    label.className = 'badge ' + (cls || '');
    label.textContent = code;
    const message = document.createElement('span');
    message.textContent = '  ' + text;
    row.append(label, message);
    results.prepend(row);
  }
  function safeUrl(value) {
    const u = new URL(value);
    if (!['http:', 'https:'].includes(u.protocol)) throw new Error('استخدم رابطًا يبدأ بـ https:// أو http://');
    return u;
  }
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (running) return;
    let url;
    try { url = safeUrl(target.value.trim()); }
    catch (e) { status.textContent = e.message || 'تحقق من الرابط.'; return; }

    stopped = false;
    running = true;
    start.disabled = true;
    stop.disabled = false;
    status.textContent = 'الاختبار يعمل. سيتم إرسال الطلبات بالتتابع وبفاصل زمني.';
    const n = Math.min(10, Math.max(1, Number(count.value) || 1));
    const pause = Math.max(1000, Number(delay.value) || 2000);

    for (let i = 1; i <= n; i++) {
      if (stopped) break;
      const began = performance.now();
      try {
        // no-cors allows a basic reachability attempt, but intentionally hides the HTTP status.
        // CORS-readable responses are requested normally; if blocked, report the limitation clearly.
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 10000);
        try {
          const response = await fetch(url.href, {
            method: 'GET',
            mode: 'cors',
            cache: 'no-store',
            signal: controller.signal
          });
          clearTimeout(timer);
          const ms = Math.round(performance.now() - began);
          totals.total++;
          if (response.status >= 200 && response.status < 300) totals.success++;
          if (response.status === 429) totals.limited++;
          updateStats();
          const retryAfter = response.headers.get('Retry-After');
          let detail = `الطلب ${i}: استجابة وصلت خلال ${ms} مللي ثانية`;
          if (response.status === 429) {
            detail += retryAfter ? ` — Retry-After: ${retryAfter}. أوقف الاختبار وانتظر المدة التي حددها الموقع.` : ' — أوقف الاختبار وانتظر قبل أي محاولة أخرى.';
            stopped = true;
          }
          addResult(detail, `${response.status} ${response.statusText || ''}`.trim(),
            response.status === 429 ? 'warn' : (response.ok ? 'ok' : 'err'));
        } catch (err) {
          clearTimeout(timer);
          totals.total++;
          updateStats();
          const isAbort = err && err.name === 'AbortError';
          addResult(isAbort ? `الطلب ${i}: انتهت مهلة الانتظار.` : `الطلب ${i}: تعذّر قراءة الاستجابة. قد تكون سياسة CORS أو الاتصال هي السبب؛ لا يمكن تأكيد رمز HTTP من المتصفح.`, 'غير متاح', 'warn');
        }
      } catch (_) {
        addResult(`الطلب ${i}: تعذّر إكماله.`, 'خطأ', 'err');
      }
      if (i < n && !stopped) await wait(pause);
    }
    running = false;
    start.disabled = false;
    stop.disabled = true;
    status.textContent = stopped ? 'توقف الاختبار. إذا ظهر 429 فانتظر ولا تحاول تجاوزه بتغيير IP.' : 'انتهى الاختبار.';
  });
  stop.addEventListener('click', () => {
    stopped = true;
    status.textContent = 'جارٍ إيقاف الاختبار بعد الطلب الحالي...';
  });
  clear.addEventListener('click', () => {
    if (running) return;
    results.replaceChildren();
    totals = { total: 0, success: 0, limited: 0 };
    updateStats();
    status.textContent = 'تم مسح النتائج.';
  });
})();
</script>
</body>
